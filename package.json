{
  "name": "er-bacpacer",
  "version": "2.0.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "qr": "evenhub qr -u http://192.168.1.45:5173 --http",
    "simulator": "evenhub-simulator http://localhost:5173",
    "pack": "npm run build && evenhub pack app.json dist -o bacpacer.ehpk --sdk-ver 0.0.16",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "even-toolkit": "^1.7.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@evenrealities/evenhub-cli": {
      "typescript": "$typescript"
    }
  }
}
